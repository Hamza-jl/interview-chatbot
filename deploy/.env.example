# ---------------------------------------------------------------------------
# Configuration du déploiement. Copiez ce fichier en .env À LA RACINE du projet
# (à côté de docker-compose.yml), puis remplissez-le.
#
#   cp deploy/.env.example .env
#
# Ne versionnez jamais le .env rempli : il contient les clés de chiffrement.
# ---------------------------------------------------------------------------

# ---- secrets : générez-les avec  python deploy/generate_keys.py -----------
# Perdre MASTER_KEK rend TOUTES les réponses déjà chiffrées définitivement
# illisibles. Conservez-en une copie hors de la machine.
MASTER_KEK=
JWT_SECRET=
DOWNLOAD_SIGNING_KEY=
POSTGRES_PASSWORD=

# Séparateur de domaine des chiffrements. Ne le changez JAMAIS après la
# première réponse collectée.
CRYPTO_NAMESPACE=interview-collect

# ---- accès ----------------------------------------------------------------
# Le port publié sur le portable-serveur.
HTTP_PORT=8080

# L'origine exacte par laquelle les correspondants arrivent. Doit correspondre
# à ce qu'ils tapent dans le navigateur, port compris.
CORS_ORIGINS=http://192.168.1.50:8080

# false en HTTP simple : un cookie Secure n'est pas renvoyé sur http://, et la
# session ne tiendrait pas. Passez à true dès que vous mettez du TLS devant.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---- inférence locale -----------------------------------------------------
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=180

# ---- identité du déploiement ---------------------------------------------
# Ces valeurs apparaissent dans les phrases de l'assistant et dans le document.
CLIENT_NAME=votre organisation
PROGRAMME_LABEL=
CONSULTING_ORG=l'equipe PCA
DOC_REFERENCE_PREFIX=EDL
CONTACT_NAME=Équipe PCA
CONTACT_EMAIL=pca@example.com
CONTACT_PHONE=

# Domaine des comptes par entité : le seed crée <code>@<domaine> pour chacune
# des 32 structures (acf@..., si@...). Mettez le domaine de messagerie réel du
# client si ces adresses doivent recevoir du courrier.
PARTICIPANT_EMAIL_DOMAIN=entites.local

# ---- journaux de conversation --------------------------------------------
# ATTENTION : ces fichiers sont EN CLAIR, dans deploy/transcripts/ côté hôte.
TRANSCRIPT_ENABLED=false
