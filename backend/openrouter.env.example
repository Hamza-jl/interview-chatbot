# Compréhension des documents par modèle distant (OpenRouter)
#
# Cette brique lit un fichier déposé pour en déduire les questions. Elle est la
# SEULE partie de l'application qui sort du réseau. L'entretien lui-même et les
# réponses des collaborateurs restent sur le modèle local.
OPENROUTER_ENABLED=true

# Une ou plusieurs clés, séparées par des virgules. Les modèles gratuits sont
# limités par clé : une deuxième clé n'est pas de la redondance, c'est du débit.
OPENROUTER_API_KEY=sk-or-v1-...,sk-or-v1-...

# Modèles gratuits uniquement, vérifiés contre le catalogue : chacun accepte un
# schéma JSON et lit les images. Essayés dans l'ordre.
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,openrouter/free,dots-studio/dots-3-note-preview:free

# Ces modèles raisonnent avant de répondre, et le raisonnement est prélevé sur
# le même budget : en dessous de ~4000, la réponse revient vide.
OPENROUTER_MAX_TOKENS=8000
OPENROUTER_TIMEOUT=180

# Rien ne part tant qu'un humain n'a pas vu ce qui partirait.
OPENROUTER_REQUIRE_REVIEW=true

# Noms retirés de tout envoi sortant, en plus des règles automatiques
# (e-mails, téléphones, IBAN, URL). Mettez-y vos clients.
OPENROUTER_REDACT_TERMS=MANSA Bank,STAR Assurances,GAT,AMI,COMAR,Cotunace,BIAT
