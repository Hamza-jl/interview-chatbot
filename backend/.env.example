# ---------------------------------------------------------------------------
# Interview Collect - backend configuration
# Generate real secrets with:  python -m app.scripts.genkeys --write
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------
ENV=dev

# --- Cryptographic material (base64) ---------------------------------------
# MASTER_KEK / DOWNLOAD_SIGNING_KEY : 32 bytes.  JWT_SECRET : 64 bytes (HS512).
MASTER_KEK=
JWT_SECRET=
DOWNLOAD_SIGNING_KEY=

# --- Database ---------------------------------------------------------------
# dev  : sqlite+pysqlite:///./var/pca.db
# prod : postgresql+psycopg://user:pass@host:5432/pca?sslmode=verify-full
DATABASE_URL=sqlite+pysqlite:///./var/pca.db

# --- Moteur conversationnel ---------------------------------------------------
# auto | anthropic | ollama | off
LLM_PROVIDER=auto

# Option A - API Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Option B - inference locale (aucune donnee ne quitte le reseau de la banque)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Web --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Contact shown in the closing modal --------------------------------------
CONTACT_NAME=Devoteam Tunisie - Practice Risk & Continuity
CONTACT_EMAIL=pca@example.com
CONTACT_PHONE=+216 71 000 000
